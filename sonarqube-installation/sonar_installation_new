#!/bin/bash
set -e

# ============================================================
# SonarQube 25.x Installation
# Java 21
# ============================================================

if [ "$(id -u)" -ne 0 ]; then
    echo "Please run this script as root or with sudo."
    exit 1
fi

echo "Updating packages..."
apt update

echo "Installing Java 21 and dependencies..."
apt install -y openjdk-21-jdk unzip wget

echo "Java version:"
java -version

# Java 21
export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
export PATH=$JAVA_HOME/bin:$PATH

# SonarQube system requirements
echo "Configuring system parameters..."

cat > /etc/sysctl.d/99-sonarqube.conf <<EOF
vm.max_map_count=524288
fs.file-max=131072
EOF

sysctl --system

# Create SonarQube user
echo "Creating SonarQube user..."

if ! id sonar >/dev/null 2>&1; then
    useradd -r -m -d /opt/sonarqube -s /bin/bash sonar
fi

# SonarQube version
SONAR_VERSION="25.9.0.112764"
SONAR_FILE="sonarqube-${SONAR_VERSION}.zip"
SONAR_URL="https://binaries.sonarsource.com/Distribution/sonarqube/${SONAR_FILE}"

# Download
echo "Downloading SonarQube ${SONAR_VERSION}..."

cd /tmp
wget -q "$SONAR_URL" -O "$SONAR_FILE"

# Install
echo "Installing SonarQube..."

rm -rf /opt/sonarqube
unzip -q "$SONAR_FILE" -d /opt

mv "/opt/sonarqube-${SONAR_VERSION}" /opt/sonarqube

chown -R sonar:sonar /opt/sonarqube

# Create systemd service
echo "Creating SonarQube service..."

cat > /etc/systemd/system/sonarqube.service <<EOF
[Unit]
Description=SonarQube
After=network.target

[Service]
Type=forking
User=sonar
Group=sonar

Environment="JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64"
Environment="SONAR_JAVA_PATH=/usr/lib/jvm/java-21-openjdk-amd64/bin/java"

ExecStart=/opt/sonarqube/bin/linux-x86-64/sonar.sh start
ExecStop=/opt/sonarqube/bin/linux-x86-64/sonar.sh stop

LimitNOFILE=131072
LimitNPROC=8192

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

# Enable and start SonarQube
echo "Starting SonarQube..."

systemctl daemon-reload
systemctl enable sonarqube
systemctl start sonarqube

# Cleanup
rm -f "/tmp/$SONAR_FILE"

echo ""
echo "================================================"
echo " SonarQube installation completed!"
echo "================================================"
echo ""
echo "Check status:"
echo "sudo systemctl status sonarqube"
echo ""
echo "Access SonarQube in your browser:"
echo "http://YOUR-SERVER-IP:9000"
echo ""
echo "Default login:"
echo "Username: admin"
echo "Password: admin"
echo "================================================"
