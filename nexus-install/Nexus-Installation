#!/usr/bin/env bash
set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive

# Sonatype Nexus 3 installation on Ubuntu 22.04 LTS (AWS EC2)
# Prerequisites:
#   - EC2 instance running Ubuntu 22.04 LTS
#   - Security group allows inbound TCP 22 and 8081
#   - User has sudo access

log() {
  echo
  echo "==> $*"
}

if ! command -v sudo >/dev/null 2>&1; then
  echo "sudo is required but not installed. Please install sudo first."
  exit 1
fi

CURRENT_USER="${USER:-$(id -un)}"
NEXUS_DATA_DIR="${HOME}/nexus-data"
NEXUS_CONTAINER_NAME="nexus"
NEXUS_PORT="8081"

log "Updating system packages"
sudo apt-get update
sudo apt-get upgrade -y

log "Installing Docker dependencies"
sudo apt-get install -y \
  ca-certificates \
  curl \
  gnupg \
  lsb-release

log "Adding Docker GPG key"
sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
  sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
sudo chmod a+r /etc/apt/keyrings/docker.gpg

log "Adding Docker repository"
ARCH="$(dpkg --print-architecture)"
CODENAME="$(lsb_release -cs)"
echo \
  "deb [arch=${ARCH} signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu ${CODENAME} stable" | \
  sudo tee /etc/apt/sources.list.d/docker.list >/dev/null

log "Installing Docker Engine"
sudo apt-get update
sudo apt-get install -y \
  docker-ce \
  docker-ce-cli \
  containerd.io

log "Enabling and starting Docker"
sudo systemctl enable docker
sudo systemctl start docker

docker --version

log "Adding ${CURRENT_USER} to the docker group"
sudo usermod -aG docker "${CURRENT_USER}"
echo "Please log out and log back in, or run: newgrp docker"

log "Creating Nexus persistent data directory"
mkdir -p "${NEXUS_DATA_DIR}"
sudo chown -R 200:200 "${NEXUS_DATA_DIR}"

log "Starting Sonatype Nexus container"
docker rm -f "${NEXUS_CONTAINER_NAME}" >/dev/null 2>&1 || true

docker run -d \
  --name "${NEXUS_CONTAINER_NAME}" \
  -p "${NEXUS_PORT}:8081" \
  -v "${NEXUS_DATA_DIR}:/nexus-data" \
  --restart unless-stopped \
  sonatype/nexus3:latest

log "Waiting for Nexus to become ready"
for i in {1..30}; do
  if curl -fsS "http://localhost:${NEXUS_PORT}/" >/dev/null 2>&1; then
    echo "Nexus is responding on port ${NEXUS_PORT}"
    break
  fi
  sleep 10
done

log "Nexus setup instructions"
echo "1. Open your AWS Security Group and allow inbound TCP 8081"
echo "2. Browse to: http://<EC2_PUBLIC_IP>:8081"
echo "3. Get the admin password:"
echo "   cat ${NEXUS_DATA_DIR}/admin.password"
echo "   or"
echo "   docker exec -it ${NEXUS_CONTAINER_NAME} cat /nexus-data/admin.password"
echo "4. Log in with username: admin"
echo "5. Change the default password when prompted"

echo

echo "Installation complete."
