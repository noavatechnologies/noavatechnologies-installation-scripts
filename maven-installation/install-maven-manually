#!/usr/bin/env bash

set -Eeuo pipefail

MAVEN_VERSION="3.9.16"
MAVEN_ARCHIVE="apache-maven-${MAVEN_VERSION}-bin.tar.gz"
MAVEN_URL="https://dlcdn.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries/${MAVEN_ARCHIVE}"
MAVEN_INSTALL_DIR="/opt/apache-maven-${MAVEN_VERSION}"
MAVEN_LINK="/opt/maven"
MAVEN_PROFILE="/etc/profile.d/maven.sh"

if [[ "${EUID}" -eq 0 ]]; then
    SUDO=""
else
    SUDO="sudo"
fi

error_handler() {
    echo "Error: installation failed on line ${BASH_LINENO[0]}." >&2
}
trap error_handler ERR

# Update system packages and install Java.
echo "Updating system packages..."
${SUDO} apt-get update

echo "Installing OpenJDK 21..."
${SUDO} apt-get install --yes openjdk-21-jdk wget

JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"
echo "Using JAVA_HOME=${JAVA_HOME}"
java --version

# Download Maven to a temporary file. Do not extract a partial or failed download.
echo "Downloading Apache Maven ${MAVEN_VERSION}..."
tmp_archive="$(mktemp --tmpdir "${MAVEN_ARCHIVE}.XXXXXX")"
trap 'rm -f "${tmp_archive}"' EXIT

if ! wget --https-only --server-response --show-progress --output-document="${tmp_archive}" "${MAVEN_URL}"; then
    echo "Error: unable to download Maven from ${MAVEN_URL}" >&2
    exit 1
fi

if [[ ! -s "${tmp_archive}" ]]; then
    echo "Error: Maven download is empty." >&2
    exit 1
fi

if ! gzip --test "${tmp_archive}"; then
    echo "Error: downloaded Maven archive is not a valid gzip file." >&2
    exit 1
fi

# Install Maven under /opt and update the stable /opt/maven link.
echo "Installing Maven in ${MAVEN_INSTALL_DIR}..."
${SUDO} rm -rf "${MAVEN_INSTALL_DIR}"
${SUDO} mkdir -p /opt
${SUDO} tar --extract --gzip --file="${tmp_archive}" --directory=/opt
${SUDO} ln --symbolic --force "${MAVEN_INSTALL_DIR}" "${MAVEN_LINK}"

# Configure Maven for login shells.
echo "Creating ${MAVEN_PROFILE}..."
${SUDO} tee "${MAVEN_PROFILE}" > /dev/null <<EOF
export JAVA_HOME=${JAVA_HOME}
export M2_HOME=${MAVEN_LINK}
export MAVEN_HOME=${MAVEN_LINK}
export PATH=\${JAVA_HOME}/bin:\${MAVEN_HOME}/bin:\${PATH}
EOF
${SUDO} chmod 0644 "${MAVEN_PROFILE}"

# Apply the configuration in the current shell and verify the installation.
# shellcheck disable=SC1091
source "${MAVEN_PROFILE}"
echo "Verifying Maven installation..."
command -v mvn
mvn --version

echo "Maven ${MAVEN_VERSION} and Java 21 were installed successfully."
